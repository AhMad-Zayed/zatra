APP_NAME="Zatara Tourism"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Riyadh
APP_URL=https://zatara.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@zatara.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Atlahub WhatsApp API
ATLAHUB_ACCOUNT_ID=
ATLAHUB_INBOX_ID=
ATLAHUB_API_TOKEN=

# Stripe Payment Gateway (disabled currently)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PDF generation (spatie/laravel-pdf, Browsershot driver) shells out to "node"/"npm" using the
# server process's inherited $PATH by default. If that PATH doesn't include them (common under
# php-fpm/systemd process managers, which don't inherit a login shell's PATH), every PDF
# (tickets, manifests, rooming lists) fails. Set these to the absolute binary paths on this
# server (e.g. `which node` / `which npm`) to bypass PATH resolution entirely.
BROWSERSHOT_NODE_PATH=
BROWSERSHOT_NPM_PATH=

# WhatsApp Business (Meta Graph API) -- required for customer OTP login delivery
# (CustomerOtpService::sendOtp()) and for booking-lifecycle WhatsApp notifications
# (WhatsAppNotificationDriver). Without WHATSAPP_TOKEN/WHATSAPP_PHONE_ID set, OTP sending fails
# loudly with a clear exception in production/staging (it does not silently no-op) -- a customer
# cannot log in via WhatsApp until these are configured. WHATSAPP_OTP_TEMPLATE must name a real,
# Meta-approved "Authentication" category template on the tenant's WhatsApp Business account; the
# default below ("otp_verification") is a placeholder name, not a template that exists yet.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_OTP_TEMPLATE=otp_verification
